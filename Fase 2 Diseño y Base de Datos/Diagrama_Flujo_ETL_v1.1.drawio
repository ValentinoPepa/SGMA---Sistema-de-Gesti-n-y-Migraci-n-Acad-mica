<mxfile host="app.diagrams.net"><diagram id="flujo-etl" name="Flujo ETL v1.1"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="Archivos legados&lt;br&gt;Alumnos_2026_Final.xlsx&lt;br&gt;Plan_Estudios.xlsx&lt;br&gt;Actas_Historicas.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="210" height="90" as="geometry"/></mxCell><mxCell id="n2" value="0. Pre-chequeos&lt;br&gt;usuario ADMIN, sin migración&lt;br&gt;definitiva previa, archivos&lt;br&gt;y columnas presentes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="220" height="90" as="geometry"/></mxCell><mxCell id="n3" value="1. Extracción&lt;br&gt;lee .xlsx y .csv sin asumir&lt;br&gt;tipos (todo como texto) y&lt;br&gt;arma el staging en memoria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="60" width="220" height="90" as="geometry"/></mxCell><mxCell id="n4" value="2. Transformación y&lt;br&gt;validación común (RF-VAL-01,&lt;br&gt;Diccionario sección 2),&lt;br&gt;fila por fila" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="60" width="220" height="90" as="geometry"/></mxCell><mxCell id="n5" value="¿Fila válida?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="55" width="150" height="100" as="geometry"/></mxCell><mxCell id="n6" value="Rechazos&lt;br&gt;errores_migracion.log&lt;br&gt;inconsistencias_actas.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="60" width="220" height="90" as="geometry"/></mxCell><mxCell id="n7" value="3. Carga transaccional&lt;br&gt;START TRANSACTION&lt;br&gt;a) un lote por archivo (lotes_carga)&lt;br&gt;b) carreras y materias&lt;br&gt;c) alumnos con legajo legado&lt;br&gt;d) CALL sp_sincronizar_legajo()&lt;br&gt;e) alumnos sin legajo&lt;br&gt;    (sp_proximo_legajo)&lt;br&gt;f) actas (lookup de DNI y materia)&lt;br&gt;g) cierra los lotes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#555555;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="840" y="260" width="250" height="230" as="geometry"/></mxCell><mxCell id="n8" value="¿Error crítico?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="150" height="100" as="geometry"/></mxCell><mxCell id="n9" value="ROLLBACK&lt;br&gt;log de falla crítica&lt;br&gt;(la base no se altera)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="520" width="220" height="80" as="geometry"/></mxCell><mxCell id="n10" value="¿Modo ensayo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="150" height="100" as="geometry"/></mxCell><mxCell id="n11" value="ROLLBACK&lt;br&gt;informe de ensayo&lt;br&gt;(no se guarda nada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="210" height="80" as="geometry"/></mxCell><mxCell id="n12" value="COMMIT&lt;br&gt;migración definitiva&lt;br&gt;origen = MIGRACION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="210" height="80" as="geometry"/></mxCell><mxCell id="n13" value="4. Informe final&lt;br&gt;informe_migracion.txt&lt;br&gt;conteos por entidad y código" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1E1E1;strokeColor=#555555;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="210" height="80" as="geometry"/></mxCell><mxCell id="nb" value="Notas&lt;br&gt;• El modo ensayo ejecuta las mismas etapas y termina siempre en ROLLBACK.&lt;br&gt;• Por defecto corre en ensayo; la migración definitiva se pide de forma explícita.&lt;br&gt;• Los legajos legados se cargan antes de sincronizar el contador, para que un legajo nuevo no choque con uno que todavía no se cargó.&lt;br&gt;• Las filas rechazadas no detienen el proceso; un error crítico sí." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#888888;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="300" width="420" height="200" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n10" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#555555;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="title" value="Diagrama de flujo de datos del ETL (migración inicial) v1.1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="5" width="700" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>