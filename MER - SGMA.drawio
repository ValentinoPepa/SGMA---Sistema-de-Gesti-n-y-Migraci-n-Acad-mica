        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nentity \&quot;Carreras\&quot; as carreras {\n  * id_carrera : INT &lt;&lt;PK&gt;&gt;\n  --\n  nombre : VARCHAR(100)\n}\n\nentity \&quot;Materias\&quot; as materias {\n  * id_materia : INT &lt;&lt;PK&gt;&gt;\n  --\n  * id_carrera : INT &lt;&lt;FK&gt;&gt;\n  codigo : VARCHAR(10)\n  nombre : VARCHAR(100)\n  anio_nivel : TINYINT\n}\n\nentity \&quot;Alumnos\&quot; as alumnos {\n  * id_alumno : INT &lt;&lt;PK&gt;&gt;\n  --\n  legajo : INT &lt;&lt;UNI&gt;&gt;\n  dni : VARCHAR(15) &lt;&lt;UNI&gt;&gt;\n  nombre : VARCHAR(50)\n  apellido : VARCHAR(50)\n  fecha_nacimiento : DATE\n  email : VARCHAR(100)\n}\n\nentity \&quot;Inscripciones\&quot; as inscripciones {\n  * id_inscripcion : INT &lt;&lt;PK&gt;&gt;\n  --\n  * id_alumno : INT &lt;&lt;FK&gt;&gt;\n  * id_materia : INT &lt;&lt;FK&gt;&gt;\n  anio_lectivo : SMALLINT\n  estado : ENUM\n}\n\nentity \&quot;Actas_Examen\&quot; as actas {\n  * id_acta : INT &lt;&lt;PK&gt;&gt;\n  --\n  * id_alumno : INT &lt;&lt;FK&gt;&gt;\n  * id_materia : INT &lt;&lt;FK&gt;&gt;\n  nota : DECIMAL(4,2)\n  fecha_examen : DATE\n  libro : VARCHAR(20)\n  folio : VARCHAR(20)\n  estado : ENUM\n}\n\nentity \&quot;Auditoria\&quot; as auditoria {\n  * id_auditoria : INT &lt;&lt;PK&gt;&gt;\n  --\n  tabla_afectada : VARCHAR(50)\n  operacion : ENUM\n  id_registro : INT\n  usuario : VARCHAR(50)\n  fecha_hora : DATETIME\n}\n\ncarreras ||--|{ materias : \&quot;contiene\&quot;\nalumnos ||--|{ inscripciones : \&quot;realiza\&quot;\nmaterias ||--|{ inscripciones : \&quot;corresponde a\&quot;\nalumnos ||--|{ actas : \&quot;rinde\&quot;\nmaterias ||--|{ actas : \&quot;evalua\&quot;\n\n&#39; Conexiones de auditoria (Trazabilidad / Triggers)\nactas ..&gt; auditoria : \&quot;audita cambios\&quot;\nalumnos ..&gt; auditoria : \&quot;audita cambios\&quot;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ESj1qh1riq9cTepdGjVA-69">
